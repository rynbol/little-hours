{
  "name": "little-hours",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test 'src/**/*.test.js' 'scripts/*.test.mjs'",
    "verify:room": "node scripts/verify-room.mjs",
    "test:e2e": "playwright test",
    "lh": "node scripts/lh.mjs",
    "guard": "node scripts/guard.mjs && oxlint --quiet src scripts e2e checks",
    "assets": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} -b --factory-startup --python scripts/assets.py --"
  },
  "dependencies": {
    "@babylonjs/core": "9.27.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "oxlint": "^1.86.0",
    "vite": "8.3.0"
  }
}
